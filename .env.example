# =============================================================================
# Dompet — Personal Finance Dashboard
# =============================================================================
# Aplikasi ini berjalan TANPA satu pun environment variable.
#
# Semua data (transaksi, anggaran, target tabungan) disimpan di localStorage
# browser pengguna. Tidak ada database, tidak ada akun, tidak ada API key —
# `npm install && npm run dev` sudah cukup, dan deploy ke Vercel tinggal klik
# Deploy tanpa mengisi apa pun.
#
# File ini hanya berisi opsi kosmetik yang opsional. Kalau tidak butuh,
# abaikan saja file ini sepenuhnya.
#
# Untuk memakainya:
#     cp .env.example .env.local
#
# .env.local sudah diabaikan git (lihat .gitignore) — jangan pernah di-commit.
# Next.js membaca file env hanya saat start, jadi restart `npm run dev` setelah
# mengubahnya.
# =============================================================================


# --- Branding (opsional) -----------------------------------------------------
# Kosong = memakai default "Dompet" dari src/app/layout.tsx
NEXT_PUBLIC_APP_NAME=

# URL publik aplikasi, untuk canonical URL dan tag Open Graph.
# Di Vercel boleh dikosongkan — NEXT_PUBLIC_VERCEL_URL terisi otomatis.
NEXT_PUBLIC_SITE_URL=


# --- Analytics (opsional) ----------------------------------------------------
# Vercel Analytics tidak butuh key — cukup aktifkan di dashboard Vercel.
# Isi dua baris ini hanya kalau memakai Plausible/Umami self-hosted.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=


# =============================================================================
# PERINGATAN UMUM
#
# Variabel berawalan NEXT_PUBLIC_ di-inline ke dalam bundle JavaScript dan bisa
# dibaca siapa pun lewat DevTools. Jangan pernah menaruh rahasia di sana.
#
# Rahasia sisi server ditulis tanpa prefix dan hanya boleh dibaca dari Server
# Component, Route Handler, atau Server Action.
# =============================================================================
